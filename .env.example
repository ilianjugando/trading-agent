# Copy this file to .env and fill in real values. Never commit .env.

# --- Mode ---
# paper = IBKR paper account + OKX Demo Trading. live = real money. Always validate in paper first.
TRADING_MODE=paper

# --- IBKR (requires IB Gateway or TWS running locally) ---
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_LIVE_PORT=7496
IBKR_CLIENT_ID=1

# --- OKX ---
# Use separate keys for Demo Trading vs live, generated in different tabs of the OKX API management page.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=

# --- Gemini ---
GEMINI_API_KEY=

# --- NVIDIA Build (optional) ---
# One key, many models: https://build.nvidia.com. Adds a panel of models
# alongside Gemini for the trade review vote -- leave blank to use Gemini alone.
NVIDIA_API_KEY=

# --- Risk limits (fractions of pool value) ---
MAX_TRADE_PCT=0.20
DAILY_LOSS_HALT_PCT=0.10
MAX_CONSECUTIVE_LOSSES=3

# --- Extra confirmation (optional, default off) ---
# When true, also reject a buy the LLM panel approved if RSI(14) >= 80
# (overbought) or the SMA(10/30) trend is down. Off by default so behavior
# doesn't change until you review signals/indicators.py and opt in.
REQUIRE_INDICATOR_CONFIRMATION=false
